# Copy to ".env" and fill in. NEVER commit the real .env file.
NODE_ENV=development
PORT=5000

# MongoDB connection (local) - on Render use a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/clinic

# Secrets used to sign tokens. Use long random strings
# (generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Frontend address(es) allowed to call the API (comma separated)
CORS_ORIGIN=http://localhost:5173

# Prescription uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Clinic time zone as minutes from UTC (Pakistan = +5h = 300)
CLINIC_TZ_OFFSET_MINUTES=300

# Used by tests only (CI sets this). If empty, tests start an in-memory MongoDB automatically.
# MONGO_URI_TEST=mongodb://127.0.0.1:27017/clinic_test
